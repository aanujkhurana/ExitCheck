{
  "name": "exit-report-frontend",
  "version": "0.1.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "lint": "eslint . --ext .js",
    "format": "prettier --write \"**/*.js\" **/*.json\"",
